  100 ! LET's see IF we use TIIF2 OR HEXTIr
  110 CALL IO(45,1,S):IF S=4 THEN DN$="101." ELSE DN$="100."
  120 DIR$="directory.int":N=100
  130 IMAGE #### #################### #
  140 GOTO 170:ON BREAK ERROR:ON ERROR 150:GOTO 170
  150 CALL ERR(EC,ET):IF ET<>6 THEN 520
  160 ON BREAK ERROR:ON ERROR 150:GOTO 170
  170 CT=0:INPUT "Pattern: ";PATTERN$
  180 I=LEN(PATTERN$)
  190 IF I>0 THEN IF SEG$(PATTERN$,I,1)<>"/" THEN I=I-1:GOTO 190
  200 IF I=0 THEN 230
  210 P$=SEG$(PATTERN$,1,I)
  220 PATTERN$=SEG$(PATTERN$,I+1,255)
  230 PRINT "reading directory...";
  240 OPEN #1,DN$&"$"&P$&PATTERN$,INPUT
  250 OPEN #2,DN$&DIR$,OUTPUT,INTERNAL,RELATIVE,VARIABLE N
  260 RESTORE #2,REC 0
  270 IF EOF(1) THEN 310
  280 INPUT #1,S$,N$,T$
  290 IF T$<>"V" THEN PRINT #2,N$;T$:CT=CT+1
  300 DISPLAY AT(21),CT;:GOTO 270
  310 CLOSE #1:CLOSE #2:PRINT:I=0:CT1=CT
  320 OPEN #1,DN$&DIR$,UPDATE,INTERNAL,RELATIVE,VARIABLE N
  330 IF CT>0 THEN 360
  340 N$="Empty":T$="E":CT=1:I=0
  350 PRINT #1,"Empty";""
  360 RESTORE #1,REC I:INPUT #1,N$,T$
  370 IF T$="-" THEN 400
  380 IF CT>0 THEN PRINT USING 130,I+1;N$;T$ ELSE PRINT
  390 K$=KEY$:K=ASC(K$):K$=CHR$(K OR 32)
  400 IF K=232 THEN IF I>0 THEN I=I-1 ELSE I=CT-1
  410 IF K=233 THEN IF I<CT-1 THEN I=I+1 ELSE I=0
  420 IF(K=254 OR K=13)AND T$="D" THEN GOSUB 640:GOTO 170
  430 IF K=252 THEN GOSUB 660:GOTO 170
  440 IF K$="x" AND T$="F" THEN GOTO 830
  450 IF K$="m" THEN GOSUB 530:GOTO 360
  460 IF K$="c" AND T$="D" THEN GOSUB 700:GOTO 170
  470 IF K$="u" THEN OPEN #2,DN$:PRINT #2,"cd ..":CLOSE #2:CLOSE #1:GOTO 170
  480 IF K$="d" THEN GOSUB 720:IF CT1=0 THEN 170 ELSE 410
  490 IF K$="r" OR K$="n" THEN GOSUB 580:GOTO 380
  500 IF K$="q" THEN 520
  510 GOTO 360
  520 END
  530 INPUT "dir name: ";NN$:IF NN$="" THEN K=0:K$="":GOTO 380
  540 CALL UPPER(NN$)
  550 OPEN #2,DN$:PRINT #2,"md "&P$&NN$:CLOSE #2
  560 RESTORE #1,REC CT:PRINT #1,NN$;"D":N$=NN$:CT=CT+1:CT1=CT1+1
  570 RESTORE #1,REC I:RETURN
  580 INPUT "new name: ";NN$:IF NN$="" THEN K=0:K$="":GOTO 380
  590 CALL UPPER(NN$)
  600 OPEN #2,DN$:PRINT #2,"rn "&P$&N$&"="&NN$:CLOSE #2
  610 RESTORE #1,REC I:PRINT #1,NN$;T$:N$=NN$
  620 RETURN
  630 K=233:K$="":RETURN
  640 CLOSE #1:P$=P$&N$&"/"
  650 RETURN
  660 CLOSE #1:I=LEN(P$):IF I>0 THEN P$=SEG$(P$,1,LEN(P$)-1)
  670 IF I>0 THEN IF SEG$(P$,I,1)<>"/" THEN I=I-1:GOTO 670
  680 P$=SEG$(P$,1,I)
  690 RETURN
  700 OPEN #2,DN$:PRINT #2,"cd "&P$&N$:CLOSE #2:CLOSE #1:GOTO 170
  710 RETURN
  720 IF P$<>"" THEN K=233:K$="":RETURN
  730 IF T$<>"D" THEN 790
  731 PRINT "Delete Dir "&N$&" Sure?: ":ANS$=KEY$
  732 IF ANS$<>"y" AND ANS$<>"Y" THEN K=233:K$="":RETURN
  735 OPEN #3,DN$:PRINT #3,"cd "&N$:CLOSE #3
  740 OPEN #3,DN$&"$",INPUT:RES=-1
  750 IF NOT EOF(3) THEN 760
  751 OPEN #4,DN$:PRINT #4,"cd ..":CLOSE #4
  752 CLOSE #3:IF RES THEN 790 ELSE RETURN
  760 INPUT #3,S$,N1$,T1$:IF T1$="D" THEN RES=0:GOTO 750
  770 IF T1$<>"V" THEN DELETE DN$&N1$
  780 GOTO 750
  790 DELETE DN$&P$&N$:K=233:K$="":T$="-":CT1=CT1-1
  800 RESTORE #1,REC I:PRINT #1,N$;T$
  810 IF CT1=0 THEN CLOSE #1
  820 RETURN
  830 CLOSE #1:PRINT:RUN DN$&P$&N$
  840 SUB UPPER(S$)
  850 U$=""
  860 FOR I=1 TO LEN(S$)
  870 C=ASC(SEG$(S$,I,1))
  880 IF C>=97 AND C<=122 THEN C=C-32
  890 U$=U$&CHR$(C)
  900 NEXT
  910 S$=U$
  920 SUBEND